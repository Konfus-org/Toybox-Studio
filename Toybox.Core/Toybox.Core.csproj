<Project Sdk="Microsoft.NET.Sdk">

  <!-- Toybox.Core: the dependency-free foundation (Utils, Rpc, Logging, EngineApi). Has no UI panels and
       references no other Toybox project. TargetFramework / Nullable / warnings-as-errors / output paths
       come from ..\Directory.Build.props. -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.28" />
    <!-- Security pin: StreamJsonRpc pulls a vulnerable MessagePack transitively; override with the patched line. -->
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="IconPacks.Avalonia" Version="2.0.0" />
  </ItemGroup>

</Project>
