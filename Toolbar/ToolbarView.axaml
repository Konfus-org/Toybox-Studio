<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Toybox.Studio.Toolbar"
             xmlns:icons="using:Toybox.Studio.Resources"
             x:Class="Toybox.Studio.Toolbar.ToolbarView"
             x:DataType="local:ToolbarViewModel">

    <UserControl.Styles>
        <!-- The floating tools read as clickable and grow noticeably on hover so the one under the
             pointer pops out of the dim row — a stronger zoom than the standard button nudge, since
             the glyphs are small. Eased by the RenderTransform transition the base button style adds. -->
        <Style Selector="ToggleButton.Basic:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.2)"/>
        </Style>
        <Style Selector="ToggleButton.Basic:pressed">
            <Setter Property="RenderTransform" Value="scale(1.08)"/>
        </Style>
        <!-- The rounded color fill behind an active tool's glyph. Drawn as the button's own content
             (the Basic ToggleButton style forces the templated background transparent, so the fill
             can't live there); the brush fades in via the transition when the tool becomes active. -->
        <Style Selector="Border.toolFill">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <!-- A movable toolbar overlay. The grip drags it to a viewport edge (orientation flips to match);
         each tool invokes its editor action and lights up while active. A small themed pill (scrim
         fill + hairline border + the theme's control rounding) floats it over the viewport; the fill
         also keeps the region hit-testable so the grip gesture owns the pointer. The buttons are
         non-focusable so a click never steals the viewport's keyboard focus mid-flight. -->
    <Border Background="{DynamicResource ThemeScrimBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="3" Margin="8"
            HorizontalAlignment="{Binding HorizontalAlignment}"
            VerticalAlignment="{Binding VerticalAlignment}">
        <StackPanel Orientation="{Binding Orientation}" Spacing="3">
            <!-- Drag handle: reposition/dock the whole toolbar. -->
            <Border local:ToolbarDockDrag.Enabled="True" Background="Transparent"
                    Cursor="SizeAll" ToolTip.Tip="Drag to dock"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <icons:IconView Kind="GripVertical" Width="14" Height="14"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2"
                                    Orientation="{Binding ((local:ToolbarViewModel)DataContext).Orientation, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolbarItemViewModel">
                        <ToggleButton Classes="Basic" Padding="0" MinWidth="0" MinHeight="0"
                                      Focusable="False"
                                      IsChecked="{Binding IsActive, Mode=OneWay}"
                                      ToolTip.Tip="{Binding Tooltip}"
                                      Command="{Binding RunCommand}">
                            <Border Classes="toolFill" Background="{Binding BackgroundBrush}">
                                <icons:IconView Width="15" Height="15" Kind="{Binding IconKind}"
                                                Foreground="{Binding IconBrush}"/>
                            </Border>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The live snap-amount badge: shown only when the toolbar sets an Annotation (the
                 transform toolbar, while snapping is effectively on via the magnet toggle or the
                 held snap key). A generic trailing chip so any toolbar can surface a status. -->
            <Border IsVisible="{Binding HasAnnotation}"
                    Background="{DynamicResource ThemeMenuHighlightBrush}"
                    BorderBrush="{DynamicResource ThemeAccentSolidBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Annotation}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextBrush}"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
