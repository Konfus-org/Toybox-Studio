<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Toybox.Studio.Shell"
        xmlns:menubar="using:Toybox.Studio.MenuBar"
        xmlns:status="using:Toybox.Studio.Status"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:dockModel="using:Dock.Model.Avalonia.Controls"
        xmlns:workspaces="using:Toybox.Studio.Workspaces"
        x:Class="Toybox.Studio.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Icon="avares://Toybox.Studio.Resources/Icons/Toybox.png"
        Title="{Binding Title}"
        Width="1440" Height="850">

    <DockPanel>
        <menubar:MenuBarView DataContext="{Binding MenuBar}" DockPanel.Dock="Top"/>

        <Border Classes="StatusBar" DockPanel.Dock="Bottom">
            <status:StatusView DataContext="{Binding Status}"/>
        </Border>

        <!-- The dockable workspace fills the client area (the viewport is its default center panel).
             The binder hands the control to the workspace — factory + the saved-or-default layout —
             when the binding delivers it; the inline empty RootDock is just a placeholder so the dock
             chrome has a non-null Layout to bind against during construction. -->
        <dock:DockControl x:Name="DockHost" Margin="6"
                          workspaces:WorkspaceBinder.Workspace="{Binding Workspace}">
            <dock:DockControl.Layout>
                <dockModel:RootDock/>
            </dock:DockControl.Layout>
        </dock:DockControl>
    </DockPanel>
</Window>
