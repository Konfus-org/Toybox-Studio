<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The assembly is Toybox.Studio.App, but the app's own code/XAML namespaces are rooted at Toybox.Studio
         (e.g. x:Class="Toybox.Studio.App"), so pin the root namespace rather than let it follow the project file. -->
    <RootNamespace>Toybox.Studio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Templates are a real on-disk project the editor copies + builds, not an embedded UI resource.
         AssetViewer is the asset-preview's bundled sky materials + textures; it's handed to the engine
         as a real asset directory at launch, so it must live on disk (copied) rather than embedded. -->
    <AvaloniaResource Include="Resources\**" Exclude="Resources\Templates\**;Resources\AssetViewer\**" />
    <None Include="Resources\Templates\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\AssetViewer\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The script editor's vendored Monaco web bundle lives beside its widget. The embedded WebView loads it
         from disk (served over loopback HTTP), so it's copied to the output dir rather than embedded as an
         AvaloniaResource. Copied preserving its path (no Link, so the solution tree shows it under
         ScriptEditor/ rather than as a virtual root folder); MonacoAssetServer reads it from the mirrored path. -->
    <None Remove="ScriptEditor\Monaco\**" />
    <None Include="ScriptEditor\Monaco\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="build\**" />
    <Compile Remove="build\**" />
    <EmbeddedResource Remove="build\**" />
    <None Remove="build\**" />
    <!-- Extracted Toybox.Studio.* projects (referenced below); keep their sources out of this project's globs. -->
    <Compile Remove="Toybox.Studio.Core\**" />
    <AvaloniaXaml Remove="Toybox.Studio.Core\**" />
    <EmbeddedResource Remove="Toybox.Studio.Core\**" />
    <None Remove="Toybox.Studio.Core\**" />
    <Compile Remove="Toybox.Studio.Settings\**" />
    <AvaloniaXaml Remove="Toybox.Studio.Settings\**" />
    <EmbeddedResource Remove="Toybox.Studio.Settings\**" />
    <None Remove="Toybox.Studio.Settings\**" />
    <Compile Remove="Toybox.Studio.Generators\**" />
    <AvaloniaXaml Remove="Toybox.Studio.Generators\**" />
    <EmbeddedResource Remove="Toybox.Studio.Generators\**" />
    <None Remove="Toybox.Studio.Generators\**" />
    <Compile Remove="Toybox.Studio.Resources\**" />
    <AvaloniaXaml Remove="Toybox.Studio.Resources\**" />
    <EmbeddedResource Remove="Toybox.Studio.Resources\**" />
    <None Remove="Toybox.Studio.Resources\**" />
    <Compile Remove="Toybox.Studio.Themes\**" />
    <AvaloniaXaml Remove="Toybox.Studio.Themes\**" />
    <EmbeddedResource Remove="Toybox.Studio.Themes\**" />
    <None Remove="Toybox.Studio.Themes\**" />
    <Compile Remove="Toybox.Studio.Assets\**" />
    <AvaloniaXaml Remove="Toybox.Studio.Assets\**" />
    <EmbeddedResource Remove="Toybox.Studio.Assets\**" />
    <None Remove="Toybox.Studio.Assets\**" />
    <Compile Remove="Toybox.Studio.ECS\**" />
    <AvaloniaXaml Remove="Toybox.Studio.ECS\**" />
    <EmbeddedResource Remove="Toybox.Studio.ECS\**" />
    <None Remove="Toybox.Studio.ECS\**" />
    <Compile Update="Logging\LogConsoleView.axaml.cs">
      <DependentUpon>LogConsoleView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.2">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.28" />
    <!-- Security pin: StreamJsonRpc pulls MessagePack 2.5.198 transitively, which has a high-severity
         advisory (GHSA-hv8m-jj95-wg3x). Override it with the patched 2.5.301 from the same line. -->
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
    <PackageReference Include="Dock.Serializer.Newtonsoft" Version="12.0.0.2" />
    <PackageReference Include="IconPacks.Avalonia" Version="2.0.0" />
    <!-- Official Avalonia WebView (WebView2 backend on Windows) — hosts the vendored Monaco script editor. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.4" PrivateAssets="All" Publish="True" />
    <PackageReference Include="HotAvalonia" Version="3.*" PrivateAssets="All" Publish="True" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Shell\Shell.axaml.cs">
      <DependentUpon>Shell.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- The EngineSync source generator (emits engine-synced properties from [EngineSync] fields). Consumed as
         an analyzer, not referenced as an assembly; its folder is excluded from this project's source globbing
         above (it must target netstandard2.0). -->
    <ProjectReference Include="Toybox.Studio.Generators\Toybox.Studio.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Toybox.Studio.Core\Toybox.Studio.Core.csproj" />
    <ProjectReference Include="Toybox.Studio.Resources\Toybox.Studio.Resources.csproj" />
    <ProjectReference Include="Toybox.Studio.Settings\Toybox.Studio.Settings.csproj" />
    <ProjectReference Include="Toybox.Studio.Themes\Toybox.Studio.Themes.csproj" />
    <ProjectReference Include="Toybox.Studio.Assets\Toybox.Studio.Assets.csproj" />
    <ProjectReference Include="Toybox.Studio.ECS\Toybox.Studio.ECS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Assets\Viewer\AssetViewerView.axaml" />
    <AdditionalFiles Include="Assets\Browser\AssetBrowserView.axaml" />
  </ItemGroup>

</Project>
