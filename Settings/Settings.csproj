<Project Sdk="Microsoft.NET.Sdk">

  <!-- The editor's persisted configuration, in two halves: the plain EditorSettings data (one JSON
       file in ~/.toybox) the SettingsManager loads and owns, and the open project's AppSettings —
       an engine-mirrored asset (built on the EngineSync codegen, like the Assets payloads) the
       manager tracks through the asset catalog. It still knows nothing about the editor features its
       sections configure; they read the plain values they need. -->

  <ItemGroup>
    <ProjectReference Include="..\Utils\Utils.csproj" />
    <ProjectReference Include="..\EngineApi\EngineApi.csproj" />
    <ProjectReference Include="..\Assets\Assets.csproj" />
    <ProjectReference Include="..\Generators\Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
