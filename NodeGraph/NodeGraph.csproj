<Project Sdk="Microsoft.NET.Sdk">

  <!-- The viewport node overlay: one node per entity drawn over the world view, projected to the entity's
       screen position and distance-scaled, each an embedded inspector with reference plugs/links. Nodes,
       tails, and links render on a plain Avalonia canvas driven by the engine's per-frame projection.
       Per-project node layout persists under the project's .toybox/nodes folder. Composed into each editor
       viewport pane by the WorldViewer. -->

  <ItemGroup>
    <ProjectReference Include="..\Utils\Utils.csproj" />
    <ProjectReference Include="..\EngineApi\EngineApi.csproj" />
    <ProjectReference Include="..\PropertyGrid\PropertyGrid.csproj" />
    <ProjectReference Include="..\WorldTree\WorldTree.csproj" />
    <ProjectReference Include="..\Projects\Projects.csproj" />
    <ProjectReference Include="..\Resources\Resources.csproj" />
    <ProjectReference Include="..\Behaviors\Behaviors.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="IconPacks.Avalonia.Lucide" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
