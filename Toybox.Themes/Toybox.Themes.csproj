<Project Sdk="Microsoft.NET.Sdk">

  <!-- Toybox.Themes: the theming system (ThemeManager/repository/appliers, Theme + ColorGradient, the log-colour
       adapter) and the color-picker widgets (Colors/, namespace ColorPickers). The theme-creator window is a
       grid+dialog consumer and lives up in the app layer, not here. -->

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toybox.Core\Toybox.Core.csproj" />
    <ProjectReference Include="..\Toybox.Settings\Toybox.Settings.csproj" />
  </ItemGroup>

</Project>
