<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Toybox.Studio.PropertyGrid.Slots"
             x:Class="Toybox.Studio.PropertyGrid.Slots.RegexValueView"
             x:DataType="local:RegexValueViewModel">
    <!-- The pattern box validates as you type: an invalid pattern still commits (it's what the user
         means) but reddens its border and shows the compiler's complaint below, so a broken regex is
         never silently ignored. The pattern reads best monospaced. -->
    <StackPanel Spacing="2">
        <TextBox Classes="field"
                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding !IsReadOnly}"
                 FontFamily="{DynamicResource ThemeMonoFontFamily}"
                 ToolTip.Tip="{Binding Error}"
                 Classes.invalid="{Binding !IsValid}">
            <TextBox.Styles>
                <!-- Redden the templated border in every interaction state so an invalid pattern stays
                     flagged whether or not the field is hovered/focused. -->
                <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeErrorBrush}"/>
                </Style>
                <Style Selector="TextBox.invalid:pointerover /template/ Border#PART_BorderElement">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeErrorBrush}"/>
                </Style>
                <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeErrorBrush}"/>
                </Style>
            </TextBox.Styles>
        </TextBox>
        <TextBlock Text="{Binding Error}" IsVisible="{Binding !IsValid}"
                   Foreground="{DynamicResource ThemeErrorBrush}"
                   FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
