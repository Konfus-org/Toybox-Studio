<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Toybox.Studio.Viewport"
             xmlns:ghost="using:Toybox.Studio.Ghost"
             xmlns:icons="using:Toybox.Studio.Resources"
             xmlns:toolbar="using:Toybox.Studio.Toolbar"
             x:Class="Toybox.Studio.Viewport.ViewportView"
             x:DataType="local:ViewportViewModel"
             Surface="{Binding CurrentSurface}"
             InteropUnavailable="{Binding InteropUnavailable, Mode=OneWayToSource}">

    <!-- THE viewport control: the code-behind imports the engine view's shared GPU texture (zero copy)
         into the SurfaceHost's composition visual and owns the cover-scaling mapping. Input is
         captured on the dedicated InputSurface (the input-binding behavior, with this control as the
         sink) so the toolbar — a LATER SIBLING — never routes its clicks through the capture: clicking
         a tool can't arm a camera drag or steal the pointer. The ghosts overlay in between. -->
    <Panel Background="Black">
        <Border x:Name="SurfaceHost" ClipToBounds="True"/>

        <Border x:Name="InputSurface" Background="Transparent"/>

        <!-- The content overlay (an editor viewport's node graph), positioned by the code-behind at the
             surface's image rect so it shares the rendered image's coordinate space. Clipped to the
             control; the host and content set no Background (x:Null, not Transparent) so their empty areas
             stay hit-transparent and pointer events fall through to InputSurface — only the nodes capture. -->
        <Panel x:Name="OverlayClip" ClipToBounds="True" Background="{x:Null}">
            <ContentControl x:Name="OverlayHost" Content="{Binding Overlay}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False"/>
        </Panel>

        <ghost:GhostView Message="{Binding EmptyMessage}" IsVisible="{Binding ShowEmptyGhost}"/>

        <!-- Empty-viewport call-to-action: a launch button shown only while the engine is fully off (crashed
             and gave up, stopped, or never started). A LATER SIBLING of the input surface so its click isn't
             swallowed by the input panel's pointer capture, and offset below the empty ghost's message so the
             two read as one empty state with a call to action. -->
        <Button Classes="action" Command="{Binding LaunchEngineCommand}"
                IsVisible="{Binding ShowLaunchPrompt}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,88,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:IconView Kind="Power" Width="16" Height="16"/>
                <TextBlock Text="Launch Engine" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Loading blocks only the viewport; the rest of the editor stays interactive. -->
        <Border Background="{DynamicResource ThemeScrimBrush}" IsVisible="{Binding ShowLoadingGhost}">
            <ghost:LoadingGhostView Message="{Binding LoadingMessage}"/>
        </Border>

        <!-- The movable overlay toolbars, topmost so their buttons stay clickable over the image.
             Each item fills the viewport region (a plain Panel items host) and aligns itself to its
             own docked edge or corner via the ToolbarView's alignment bindings. -->
        <ItemsControl ItemsSource="{Binding Toolbars}" IsVisible="{Binding ShowToolbars}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Panel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="toolbar:ToolbarViewModel">
                    <toolbar:ToolbarView/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</UserControl>
