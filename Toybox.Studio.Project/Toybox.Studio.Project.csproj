<Project Sdk="Microsoft.NET.Sdk">

  <!-- Toybox.Assets: the project's asset system — the asset handle API (Asset/Asset<T>), the catalog + factory,
       the typed asset data (Material/Texture/Model/Script/…), the project manager + native build, and the
       clipboard. UI orchestration (opening assets, the asset viewer/browser panels) lives up in the app layer;
       this layer reaches it through IAssetOpener/IUserPrompt. -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toybox.Studio.Core\Toybox.Studio.Core.csproj" />
    <ProjectReference Include="..\Toybox.Studio.Resources\Toybox.Studio.Resources.csproj" />
    <ProjectReference Include="..\Toybox.Studio.Settings\Toybox.Studio.Settings.csproj" />
    <!-- The EngineSync generator emits the wire sync for the typed asset data ([EngineSync] fields). -->
    <ProjectReference Include="..\Toybox.Studio.Generators\Toybox.Studio.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
