<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Toybox.Studio.Resources"
             xmlns:local="using:Toybox.Studio.MenuBar"
             x:Class="Toybox.Studio.MenuBar.MenuBarView"
             x:DataType="local:MenuBarViewModel">

    <UserControl.Styles>
        <!-- One size for every menu glyph; colors stay per-item (semantic). -->
        <Style Selector="MenuItem icons|IconView">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- The row theme the data-driven Window and Layout menus share: icon + title, the row's own
             command. -->
        <ControlTheme x:Key="WindowMenuItemTheme" TargetType="MenuItem" x:DataType="local:WindowMenuItem"
                      BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding}"/>
            <Setter Property="HeaderTemplate">
                <DataTemplate x:DataType="local:WindowMenuItem">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:IconView Kind="{Binding Icon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter>
            <Setter Property="Command" Value="{Binding OpenCommand}"/>
        </ControlTheme>
    </UserControl.Resources>

    <Menu>
        <MenuItem Header="Edit">
            <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}">
                <MenuItem.Icon>
                    <icons:IconView Kind="Settings"/>
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
        <MenuItem Header="Build">
            <MenuItem Header="{Binding AppName}">
                <MenuItem.Icon>
                    <icons:IconView Kind="Hammer" Foreground="{DynamicResource ThemeSuccessBrush}"/>
                </MenuItem.Icon>
                <MenuItem Header="Debug" Command="{Binding BuildAppDebugCommand}">
                    <MenuItem.Icon>
                        <icons:IconView Kind="Bug" Foreground="{DynamicResource ThemeWarningBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Release" Command="{Binding BuildAppReleaseCommand}">
                    <MenuItem.Icon>
                        <icons:IconView Kind="Package" Foreground="{DynamicResource ThemeSuccessBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Engine" Command="{Binding BuildEngineCommand}">
                <MenuItem.Icon>
                    <icons:IconView Kind="Cog"/>
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
        <MenuItem Header="Debug">
            <MenuItem Header="Attach To Running Build" Command="{Binding AttachToRunningBuildCommand}">
                <MenuItem.Icon>
                    <icons:IconView Kind="Plug" Foreground="{DynamicResource ThemeInfoBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
        <!-- Data-driven: one row per registered [Dockable] (icon + title). -->
        <MenuItem Header="Window" ItemsSource="{Binding WindowItems}"
                  ItemContainerTheme="{StaticResource WindowMenuItemTheme}"/>
        <!-- The dock-arrangement actions: save / load / reset. -->
        <MenuItem Header="Layout" ItemsSource="{Binding LayoutItems}"
                  ItemContainerTheme="{StaticResource WindowMenuItemTheme}"/>
    </Menu>
</UserControl>
