<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Toybox.Studio.PropertyGrid.Slots"
             xmlns:behaviors="using:Toybox.Studio.Behaviors"
             x:Class="Toybox.Studio.PropertyGrid.Slots.NumberValueView"
             x:DataType="local:NumberValueViewModel">
    <!-- Drag the frame corners or the spinner buttons left/right to scrub the value (behaviors:NumberScrubBehavior). -->
    <NumericUpDown Classes="field"
                   Value="{Binding Value}"
                   Increment="{Binding Increment}"
                   FormatString="{Binding Format}"
                   IsEnabled="{Binding !IsReadOnly}"
                   HorizontalAlignment="Stretch"
                   behaviors:NumberScrubBehavior.Enabled="True"/>
</UserControl>
