<Project Sdk="Microsoft.NET.Sdk">

  <!-- The dependency-free foundation: general utilities and the typed-event bus (Events/).
       Everything else references this; this references nothing of ours. -->

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- ActivatorUtilities (used by the ViewModelFactory) lives in the DI abstractions; the foundation
         takes only the abstractions, never the container implementation. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
