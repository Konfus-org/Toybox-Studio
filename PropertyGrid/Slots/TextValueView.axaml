<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Toybox.Studio.PropertyGrid.Slots"
             x:Class="Toybox.Studio.PropertyGrid.Slots.TextValueView"
             x:DataType="local:TextValueViewModel">
    <!-- Read-only values disable outright (grayed by the theme's disabled state), like every other
         value editor — not the still-editable-looking TextBox read-only mode. -->
    <TextBox Classes="field" Text="{Binding Value}" IsEnabled="{Binding !IsReadOnly}"/>
</UserControl>
