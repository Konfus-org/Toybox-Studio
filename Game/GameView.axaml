<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Toybox.Studio.Game"
             xmlns:viewport="using:Toybox.Studio.Viewport"
             xmlns:toolbar="using:Toybox.Studio.Toolbar"
             xmlns:pg="using:Toybox.Studio.PropertyGrid"
             xmlns:u="using:Toybox.Studio.Utils"
             x:Class="Toybox.Studio.Game.GameView"
             x:DataType="local:GameViewModel">

    <!-- The game frame fills the whole panel; the transport (Play/Stop/Pause) is the same movable, data-driven
         toolbar the viewport uses, floating over the frame and positioning itself from its docked edge. -->
    <Panel>
        <!-- ViewportInput captures pointer/keyboard while focused and forwards it to the game; the input
             panel's DataContext is the game viewport (the input sink). An opaque near-black backdrop makes
             the panel hit-testable and gives the aspect-preserving image its letterbox/pillarbox bars. The
             cursor hides while the game requests relative (mouselook) mode AND the panel is focused, so
             Alt+Esc (which drops focus) hands the cursor back even though the game still requests it. -->
        <Panel x:Name="Surface" DataContext="{Binding Viewport}" x:DataType="local:GameViewportViewModel"
               Background="#FF0A0A0E" Focusable="True" viewport:ViewportInput.Enabled="True">
            <Panel.Cursor>
                <MultiBinding Converter="{x:Static viewport:RelativeMouseCursorConverter.Instance}">
                    <Binding Path="RelativeMouse"/>
                    <Binding Path="IsFocused" ElementName="Surface"/>
                </MultiBinding>
            </Panel.Cursor>

            <viewport:ViewportSurfaceView DataContext="{Binding Surface}"/>
        </Panel>

        <!-- Empty-frame CTA: a launch button shown only while the engine is fully off (not compiling, loading,
             or running), same as the editor viewport. A sibling of the input Surface (not a child) so its
             click isn't light-dismissed by the input panel's pointer capture; bound to the game viewport VM.
             Offset below the surface's empty ghost so the two read as one empty state with a call to action. -->
        <Button DataContext="{Binding Viewport}" x:DataType="local:GameViewportViewModel"
                Classes="action" Command="{Binding LaunchEngineCommand}"
                IsVisible="{Binding IsEngineOff}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,88,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <pg:IconView IconName="Power" IconColor="{x:Static u:Colors.Green}" Width="16" Height="16"/>
                <TextBlock Text="Launch Engine" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <toolbar:ToolbarView DataContext="{Binding Transport}"/>
    </Panel>
</UserControl>
