<Project Sdk="Microsoft.NET.Sdk">

  <!-- Toybox.Studio.Behaviors: generic, dependency-light Avalonia interaction/animation infrastructure —
       attached-property behaviors (tap/pointer commands, rename box, drag indicators) and the micro-animation
       behaviors + MotionTokens. Foundational UI glue used across every panel, so it sits low (references only
       Core). Domain-specific behaviors (e.g. world-tree selection) live up in the app layer. -->

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toybox.Studio.Core\Toybox.Studio.Core.csproj" />
  </ItemGroup>

</Project>
