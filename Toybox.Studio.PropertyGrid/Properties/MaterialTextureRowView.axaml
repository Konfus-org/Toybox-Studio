<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Toybox.Studio.PropertyGrid"
             x:Class="Toybox.Studio.PropertyGrid.MaterialTextureRowView"
             x:DataType="local:MaterialTextureRowViewModel">
    <!-- One texture definition on a single row: its editable name, the default-texture picker (the standard
         asset picker's control, hosted inline so it carries no nested label/row chrome), and a delete button. -->
    <Border BorderBrush="{DynamicResource ThemeGrooveBrush}" BorderThickness="0,0,0,1"
            BoxShadow="0 1 0 0 #2EFFFFFF" Background="Transparent">
        <Grid Background="{Binding Picker.Depth, Converter={x:Static local:DepthToBrushConverter.Instance}}"
              ColumnDefinitions="150,10,*,Auto" MinHeight="26"
              Margin="{Binding Picker.Depth, Converter={x:Static local:DepthToIndentConverter.Instance}}">
            <TextBox Grid.Column="0" Classes="field" Text="{Binding Name}" VerticalAlignment="Center"
                     Watermark="name"/>
            <Border Grid.Column="2" Classes="fieldHost" DataContext="{Binding Picker}"
                    x:DataType="local:PickerPropertyViewModel">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="fieldButton" Command="{Binding PickCommand}"
                            VerticalAlignment="Stretch" Margin="3,0,0,0" ToolTip.Tip="{Binding PickTooltip}">
                        <local:IconView Width="14" Height="14" IconName="{Binding IconName}"
                                        Foreground="{DynamicResource ThemeTextBrush}"/>
                    </Button>
                    <Button Command="{Binding ActivateCommand}" Cursor="Hand"
                            HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                            Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding PickTooltip}">
                        <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource ThemeFontSizeSmall}"
                                   Foreground="{DynamicResource ThemeAccentSolidBrush}" TextDecorations="Underline"/>
                    </Button>
                </DockPanel>
            </Border>
            <Button Grid.Column="3" Classes="fieldButton" Command="{Binding RemoveCommand}"
                    VerticalAlignment="Center" Margin="4,0,0,0" ToolTip.Tip="Remove texture">
                <local:IconView Width="13" Height="13" IconName="X"
                                Foreground="{DynamicResource ThemeMutedTextBrush}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
