<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="using:Toybox.Studio.Behaviors"
        xmlns:studio="using:Toybox.Studio"
        x:Class="Toybox.Studio.ProjectPickerWindow"
        x:DataType="studio:ProjectPickerViewModel"
        Title="Projects"
        Icon="avares://Toybox.Studio.Resources/Icons/Toybox.png"
        Width="720" Height="460" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24">

        <TextBlock Grid.Row="0" Text="Projects" FontSize="{DynamicResource ThemeFontSizeLarge}"
                   FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,12"/>

        <!-- The flat project list: double-tap a row to open it (each row's tooltip says so and previews
             the project's README); a row's ✕ forgets it without touching the project on disk. -->
        <ListBox Grid.Row="1" Background="Transparent"
                 ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                 IsVisible="{Binding HasProjects}"
                 behaviors:DoubleTapCommandBehavior.Command="{Binding OpenCommand}">
            <ListBox.Styles>
                <!-- Rows span the full width so the ✕ hugs the right edge. -->
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
                <!-- The remove ✕ only surfaces while its row is hovered (fading in, so the row doesn't
                     flicker), red to read as "this forgets the row". -->
                <Style Selector="ListBoxItem Button.remove">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="ListBoxItem:pointerover Button.remove">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <!-- Hovering the ✕ itself brightens the red (Fluent would otherwise swap in the plain
                     button ink); pressing settles back on the base red. -->
                <Style Selector="ListBoxItem Button.remove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeErrorHoverBrush}"/>
                </Style>
                <Style Selector="ListBoxItem Button.remove:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeErrorBrush}"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="studio:ProjectViewModel">
                    <DockPanel ToolTip.Tip="{Binding Tooltip}">
                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="28" Height="28"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Classes="Basic remove" Content="✕"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource ThemeErrorBrush}"
                                Command="{Binding $parent[ListBox].((studio:ProjectPickerViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}"/>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextBrush}"/>
                            <TextBlock Text="{Binding Path}" FontSize="{DynamicResource ThemeFontSizeSmall}"
                                       Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="No projects yet — create or open one below."
                   Foreground="{DynamicResource ThemeMutedTextBrush}" IsVisible="{Binding !HasProjects}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- The actions: Cancel (leave without a project — same as closing the window) sits alone on the
             left; the openers are right-aligned, with the selection-opener as the default (Enter). Each
             wears its semantic theme colour: stop-red to leave, play-green to create, refresh-blue to
             browse, and the brand action colour on the primary opener. -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Classes="stop" Content="Cancel" Command="{Binding CancelCommand}"
                    ToolTip.Tip="Close without opening a project."/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="play" Content="New" Command="{Binding NewCommand}"
                        ToolTip.Tip="Create a new project from the template."/>
                <Button Classes="refresh" Content="Open from disk" Command="{Binding BrowseCommand}"
                        ToolTip.Tip="Open an existing project from disk."/>
                <Button Classes="action" Content="Open selected" Command="{Binding OpenCommand}" IsDefault="True"
                        ToolTip.Tip="Open the selected project."/>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="3" Text="{Binding Warning}"
                   Foreground="{DynamicResource ThemeErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                   IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </Grid>
</Window>
