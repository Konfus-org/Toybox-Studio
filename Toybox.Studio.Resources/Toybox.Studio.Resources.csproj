<Project Sdk="Microsoft.NET.Sdk">

  <!-- Toybox.Resources: the editor's shared resources — the strong Lucide icon code (the Icon enum alias +
       parse/serialize helpers) and, going forward, bundled resource files (icons, editor assets, templates).
       A dependency-free leaf (like Core); referenced by any project that needs icons or resources. -->

  <PropertyGroup>
    <RootNamespace>Toybox.Resources</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="IconPacks.Avalonia" Version="2.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- References Core for the PaletteColor token used by the icon metadata attributes. -->
  <ItemGroup>
    <ProjectReference Include="..\Toybox.Studio.Core\Toybox.Studio.Core.csproj" />
  </ItemGroup>

</Project>
