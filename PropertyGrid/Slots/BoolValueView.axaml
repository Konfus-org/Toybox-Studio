<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Toybox.Studio.PropertyGrid.Slots"
             x:Class="Toybox.Studio.PropertyGrid.Slots.BoolValueView"
             x:DataType="local:BoolValueViewModel">
    <!-- A bare pill toggle (no on/off text), left-aligned to sit as the row's value like the old grid. -->
    <ToggleSwitch IsChecked="{Binding Value}" IsEnabled="{Binding !IsReadOnly}"
                  OnContent="" OffContent="" MinHeight="0" Padding="0" HorizontalAlignment="Left"/>
</UserControl>
