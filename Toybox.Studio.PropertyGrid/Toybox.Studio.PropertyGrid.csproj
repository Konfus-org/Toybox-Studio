<Project Sdk="Microsoft.NET.Sdk">

  <!-- Toybox.Studio.PropertyGrid: the type-driven property grid and ALL its editors — generic widgets plus the
       domain-specific ones (asset/handle/entity pickers, material instance, colour). It sits above the domains
       it edits (Assets, ECS, Themes) and above the low UI infra (Behaviors); the grid-consuming inspectors that
       build grids live up in the app layer. -->

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="IconPacks.Avalonia" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toybox.Studio.Core\Toybox.Studio.Core.csproj" />
    <ProjectReference Include="..\Toybox.Studio.Behaviors\Toybox.Studio.Behaviors.csproj" />
    <ProjectReference Include="..\Toybox.Studio.Resources\Toybox.Studio.Resources.csproj" />
    <ProjectReference Include="..\Toybox.Studio.Themes\Toybox.Studio.Themes.csproj" />
    <ProjectReference Include="..\Toybox.Studio.Assets\Toybox.Studio.Assets.csproj" />
    <ProjectReference Include="..\Toybox.Studio.ECS\Toybox.Studio.ECS.csproj" />
  </ItemGroup>

</Project>
