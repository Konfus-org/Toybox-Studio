<Project Sdk="Microsoft.NET.Sdk">

  <!-- The application: composition root, splash + main window, and the concrete engine
       settings/project/build services the EngineApi session is driven by. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Toybox.Studio</AssemblyName>
    <RootNamespace>Toybox.Studio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Utils\Utils.csproj" />
    <ProjectReference Include="..\Logging\Logging.csproj" />
    <ProjectReference Include="..\CMake\CMake.csproj" />
    <ProjectReference Include="..\Rpc\Rpc.csproj" />
    <ProjectReference Include="..\AppHosting\AppHosting.csproj" />
    <ProjectReference Include="..\EngineApi\EngineApi.csproj" />
    <ProjectReference Include="..\Behaviors\Behaviors.csproj" />
    <ProjectReference Include="..\Overlays\Overlays.csproj" />
    <ProjectReference Include="..\Console\Console.csproj" />
    <ProjectReference Include="..\Status\Status.csproj" />
    <ProjectReference Include="..\Viewport\Viewport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
