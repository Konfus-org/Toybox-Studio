<Project Sdk="Microsoft.NET.Sdk">

  <!-- The EngineSync source generator: turns [EngineSync] partial properties/methods into engine-synced
       implementations (see EngineApi/EngineSyncAttribute.cs). netstandard2.0 because every Roslyn
       component must be; consumers reference it as an analyzer (OutputItemType="Analyzer",
       ReferenceOutputAssembly="false"), never as a runtime dependency. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008: this in-repo generator doesn't keep analyzer release-tracking files. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
