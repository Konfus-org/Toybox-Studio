<Project>

  <PropertyGroup>
    <!-- Project files are named by their folder alone (Utils, Shell, …) since the repo IS
         Toybox.Studio; the produced assemblies and namespaces keep the full Toybox.Studio.* form.
         (The Launcher exe overrides both to plain "Toybox.Studio"; the Shell library joins it in
         the root namespace.) -->
    <AssemblyName>Toybox.Studio.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Toybox.Studio.$(MSBuildProjectName)</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- All build artifacts live under build/ at the repo root, scoped per project so the
       Toybox.Studio.* projects don't collide in a shared bin/obj. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

</Project>
