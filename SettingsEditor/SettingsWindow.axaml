<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Toybox.Studio.SettingsEditor"
        x:Class="Toybox.Studio.SettingsEditor.SettingsWindow"
        x:DataType="local:SettingsViewModel"
        Title="{Binding Title}"
        Width="620" Height="640"
        WindowStartupLocation="CenterOwner">

    <local:SettingsView Margin="{DynamicResource ThemePanelPadding}"/>
</Window>
