<Project Sdk="Microsoft.NET.Sdk">

  <!-- The log console dockable: bridges the unified Logger stream into the generic Console widget, mapping
       log levels to severities and turning each line's "[file:line]" prefix into a link that opens the real
       source file (editor lines carry their full path; engine lines are resolved best-effort against the
       engine/project source trees). -->

  <ItemGroup>
    <ProjectReference Include="..\Utils\Utils.csproj" />
    <ProjectReference Include="..\Console\Console.csproj" />
    <ProjectReference Include="..\Logging\Logging.csproj" />
    <ProjectReference Include="..\Projects\Projects.csproj" />
    <ProjectReference Include="..\Dialogs\Dialogs.csproj" />
    <ProjectReference Include="..\Coding\Coding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
