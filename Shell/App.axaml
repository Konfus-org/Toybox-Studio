<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Toybox.Studio.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme/>
        <!-- All app styling — design tokens and control styles — lives in this single stylesheet. -->
        <StyleInclude Source="/AppStyles.axaml"/>
    </Application.Styles>
</Application>
