<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Toybox.Studio.PropertyGrid.Slots"
             x:Class="Toybox.Studio.PropertyGrid.Slots.EnumValueView"
             x:DataType="local:EnumValueViewModel">
    <ComboBox Classes="field"
              ItemsSource="{Binding Choices}"
              SelectedItem="{Binding Value}"
              IsEnabled="{Binding !IsReadOnly}"
              HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="local:EnumChoice">
                <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Tooltip}"/>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
