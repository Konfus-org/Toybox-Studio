<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Settings panel: an asset owner whose body is three tabbed property grids over drafts —
       Editor (the editor settings, committed through SettingsManager), Project (the open project's
       AppSettings mirror, landed as whole-record pushes and saved through the asset), and
       Keybindings (the editor keymap, one chord-capture row per action, committed through the
       EditorKeymap). One Save lands every edited tab. Opened by the menu bar's Edit menu, in its
       own window. -->

  <ItemGroup>
    <ProjectReference Include="..\Utils\Utils.csproj" />
    <ProjectReference Include="..\Settings\Settings.csproj" />
    <ProjectReference Include="..\Keybindings\Keybindings.csproj" />
    <ProjectReference Include="..\KeybindingsEditor\KeybindingsEditor.csproj" />
    <ProjectReference Include="..\AssetOwners\AssetOwners.csproj" />
    <ProjectReference Include="..\PropertyGrid\PropertyGrid.csproj" />
    <ProjectReference Include="..\Behaviors\Behaviors.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
