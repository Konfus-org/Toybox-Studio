<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:core="using:Dock.Model.Core"
        xmlns:controls="using:Dock.Model.Controls"
        xmlns:converters="using:Dock.Avalonia.Converters"
        xmlns:icons="using:Toybox.Studio.Resources"
        xmlns:workspaces="using:Toybox.Studio.Workspaces">

    <!-- DOCKING CHROME — panels, drop-target selectors, dock tabs and pinned tabs. Surface gradients and
         accent colours come from ThemeApplier/DockBrushApplier (they route the active theme onto Dock's
         real brush keys); this sheet handles shape, spacing, header icons, and the states Dock's stock
         theme colours wrongly for us. -->

    <Styles.Resources>
        <!-- Flat, hover-less Button theme for the pinned-tool tab's inner toggle (see the ToolPinItemControl
             styles below). Avalonia's default Fluent Button re-tints its own ContentPresenter white on
             pointerover/press via its private resources — not via the Button Background — and that
             ContentPresenter sits one template level too deep to reach from a ToolPinItemControl selector.
             Swapping the Button's Theme for this transparent one removes that stray tint. -->
        <ControlTheme x:Key="PinTabButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Background="Transparent"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- DROP-TARGET SELECTORS — Dock's drag drop-target squares are baked white PNGs. DockSelectorTinter
         multiply-tints them to the primary accent at runtime into these DynamicResource keys; here we point
         each selector Image (DockTarget + GlobalDockTarget) at the recoloured bitmap, overriding Dock's
         hardcoded Source. -->
    <Style Selector="dock|DockTarget /template/ Image#PART_TopSelector, dock|GlobalDockTarget /template/ Image#PART_TopSelector">
        <Setter Property="Source" Value="{DynamicResource DockSelectorTopImage}"/>
    </Style>
    <Style Selector="dock|DockTarget /template/ Image#PART_BottomSelector, dock|GlobalDockTarget /template/ Image#PART_BottomSelector">
        <Setter Property="Source" Value="{DynamicResource DockSelectorBottomImage}"/>
    </Style>
    <Style Selector="dock|DockTarget /template/ Image#PART_LeftSelector, dock|GlobalDockTarget /template/ Image#PART_LeftSelector">
        <Setter Property="Source" Value="{DynamicResource DockSelectorLeftImage}"/>
    </Style>
    <Style Selector="dock|DockTarget /template/ Image#PART_RightSelector, dock|GlobalDockTarget /template/ Image#PART_RightSelector">
        <Setter Property="Source" Value="{DynamicResource DockSelectorRightImage}"/>
    </Style>
    <Style Selector="dock|DockTarget /template/ Image#PART_CenterSelector, dock|GlobalDockTarget /template/ Image#PART_CenterSelector">
        <Setter Property="Source" Value="{DynamicResource DockSelectorInsideImage}"/>
    </Style>

    <!-- ALWAYS-VISIBLE DOCKS. Dock's stock ToolDockControl template hides the whole chrome when the
         dock has no dockables (IsVisible bound to VisibleDockables.Count) — an empty dock then renders
         nothing hit-testable, so the main window's guaranteed center area offered no drop target once
         its last panel left. This is a faithful copy of Dock 12.0.0.2's template MINUS that gate: an
         empty dock keeps its chrome (an empty card that reads as "the dock area") and its
         IsDropArea/IsDockTarget surfaces, so panels can always be dragged back in. Empty docks that are
         allowed to collapse still zero-size via the proportional panel, so this changes nothing for
         them — only the pinned center stays. -->
    <Style Selector="dock|ToolDockControl">
        <Setter Property="Template">
            <ControlTemplate>
                <DockableControl Name="PART_DockableControl"
                                 TrackingMode="Visible"
                                 Background="{TemplateBinding Background}"
                                 DockProperties.IsDropArea="True"
                                 DockProperties.IsDockTarget="True"
                                 x:DataType="controls:IToolDock">
                    <dock:ToolChromeControl IsActive="{Binding IsActive}">
                        <dock:ToolControl/>
                    </dock:ToolChromeControl>
                </DockableControl>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Each docked panel is a card inset by a small margin so the window background shows between
         cards; its shadow comes from the theme. -->
    <Style Selector="dock|ToolChromeControl">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect" Value="{DynamicResource ThemePanelShadowEffect}"/>
    </Style>
    <Style Selector="dock|ToolChromeControl /template/ Border">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- Square, content-clipping header border. NOTE: in Dock 12.0.0.2 the ToolChromeControl PART_Border wraps
         ONLY the title-bar grip (VerticalAlignment=Top, Grid.Row 0); its content (the nested ToolControl) is a
         SEPARATE PART_ContentPresenter in Grid.Row 1. -->
    <Style Selector="dock|ToolChromeControl /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <!-- The focused (active) docked panel gets a primary-accent ring: the chrome header takes top+sides
         and ToolControl's content Border a full box whose bottom lands just above the tab strip. -->
    <Style Selector="dock|ToolChromeControl:active /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="2,2,2,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentSolidBrush}"/>
    </Style>
    <Style Selector="dock|ToolChromeControl:active dock|ToolControl /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentSolidBrush}"/>
    </Style>

    <!-- PANEL HEADER ICONS. Each dockable advertises a Lucide icon via [Dockable(Icon=…)]; the factory
         stamps it onto the panel's DockPanelRecord, and these two rules render it in the panel's two
         headers: the bottom tab strip and the top chrome title bar. The icon is read null-safely from
         the dockable through DockPanelRecordIconConverter, so a dockable without one just shows no glyph. -->

    <!-- Tab strip: Dock's ToolTabStripItem has a PART_IconPresenter fed by the tool dock's IconTemplate,
         which ToolControl pushes down to its tab strip. -->
    <Style Selector="dock|ToolControl">
        <Setter Property="IconTemplate">
            <DataTemplate x:DataType="core:IDockable">
                <icons:IconView Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                Kind="{Binding Converter={x:Static workspaces:DockPanelRecordIconConverter.Instance}}"/>
            </DataTemplate>
        </Setter>
    </Style>

    <!-- Chrome title bar: Dock's ToolChromeControl has no icon slot, so we override its template (a faithful
         copy of Dock 12's, with an IconView prepended to PART_Title). PART_ names are preserved so the base
         control-theme's part styling (button geometries, grip, divider) and our own header rules above still
         apply. x:DataType matches Dock's own template so the copied {Binding}s compile (including the
         (core:IDock) capability casts) instead of failing to resolve the cast type at runtime. -->
    <Style Selector="dock|ToolChromeControl">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*" x:DataType="controls:IToolDock">
                    <DeferredContentPresenter x:Name="PART_ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              Grid.Row="1" />
                    <Border x:Name="PART_Border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            VerticalAlignment="Top"
                            ContextFlyout="{TemplateBinding ToolFlyout}"
                            Grid.Row="{Binding GripMode, Converter={x:Static GripModeConverters.GridRowAutoHideConverter}}">
                        <Grid x:Name="PART_Grip">
                            <DockPanel LastChildFill="True" Margin="{DynamicResource DockToolChromeHeaderMargin}">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <icons:IconView Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                                    Kind="{Binding ActiveDockable, Converter={x:Static workspaces:DockPanelRecordIconConverter.Instance}}"/>
                                    <!-- Null fallback: an EMPTY dock (the kept-alive center) has no
                                         ActiveDockable and must not read "TITLE". -->
                                    <TextBlock x:Name="PART_Title"
                                               Text="{Binding ActiveDockable.Title, FallbackValue={x:Null}}" />
                                </StackPanel>
                                <!-- No buttons on an EMPTY dock's header (the kept-alive center card):
                                     they operate on ActiveDockable, and CloseDockable(null) is a crash. -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            IsVisible="{Binding ActiveDockable, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Button x:Name="PART_MenuButton"
                                            Theme="{TemplateBinding MenuButtonTheme}"
                                            Flyout="{TemplateBinding ToolFlyout}">
                                        <Viewbox Margin="{DynamicResource DockToolChromeMenuIconMargin}">
                                            <Path x:Name="PART_MenuPath" />
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="PART_PinButton"
                                            Command="{Binding Owner.Factory.PinDockable}"
                                            CommandParameter="{Binding ActiveDockable}"
                                            Theme="{TemplateBinding PinButtonTheme}">
                                        <Button.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <MultiBinding Converter="{x:Static converters:DockCapabilityConverters.CanPinMultiConverter}">
                                                    <Binding Path="ActiveDockable" />
                                                    <Binding Path="ActiveDockable.CanPin" />
                                                    <Binding Path="ActiveDockable.DockCapabilityOverrides.CanPin" />
                                                    <Binding Path="(core:IDock).DockCapabilityPolicy.CanPin" />
                                                </MultiBinding>
                                                <TemplateBinding Property="IsFloating" Converter="{x:Static BoolConverters.Not}" />
                                            </MultiBinding>
                                        </Button.IsVisible>
                                        <Viewbox>
                                            <Path x:Name="PART_PinPath" />
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="PART_MaximizeRestoreButton"
                                            IsVisible="{TemplateBinding IsFloating}"
                                            Theme="{TemplateBinding MaximizeButtonTheme}">
                                        <Viewbox>
                                            <Path x:Name="PART_MaximizeRestorePath" />
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="PART_CloseButton"
                                            Command="{Binding Owner.Factory.CloseDockable}"
                                            CommandParameter="{Binding ActiveDockable}"
                                            Theme="{TemplateBinding CloseButtonTheme}">
                                        <Button.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <MultiBinding Converter="{x:Static converters:DockCapabilityConverters.CanCloseMultiConverter}">
                                                    <Binding Path="ActiveDockable" />
                                                    <Binding Path="ActiveDockable.CanClose" />
                                                    <Binding Path="ActiveDockable.DockCapabilityOverrides.CanClose" />
                                                    <Binding Path="(core:IDock).DockCapabilityPolicy.CanClose" />
                                                </MultiBinding>
                                                <MultiBinding Converter="{x:Static converters:CanRemoveDockableConverter.Instance}">
                                                    <Binding Path="(core:IDock).CanCloseLastDockable" FallbackValue="{x:True}" />
                                                    <Binding Path="(core:IDock).VisibleDockables.Count" FallbackValue="0" />
                                                </MultiBinding>
                                            </MultiBinding>
                                        </Button.IsVisible>
                                        <Viewbox>
                                            <Path x:Name="PART_ClosePath" />
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                                <Grid x:Name="PART_Grid" />
                            </DockPanel>
                        </Grid>
                    </Border>
                    <Panel x:Name="PART_Panel"
                           Background="{TemplateBinding BorderBrush}"
                           Height="{DynamicResource DockToolChromeDividerThickness}"
                           VerticalAlignment="Top"
                           Grid.Row="{Binding GripMode, Converter={x:Static GripModeConverters.GridRowAutoHideConverter}}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Dock panel-chrome buttons (pin / menu / close in a title bar, and a tab's close button) are icon
         buttons. They carry no class, so a single /template/ hop flattens their fill to transparent
         (Fluent binds the presenter background to Button.Background). A faint band shows on hover. -->
    <Style Selector="dock|ToolChromeControl /template/ Button, dock|ToolTabStripItem /template/ Button, dock|DocumentTabStripItem /template/ Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="dock|ToolChromeControl /template/ Button:pointerover, dock|ToolTabStripItem /template/ Button:pointerover, dock|DocumentTabStripItem /template/ Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBandBrush}"/>
    </Style>
    <!-- When a panel is FOCUSED its header fills with the primary accent; Dock's active state otherwise
         tints the pin/menu/close glyphs the accent colour (≈ the header colour → invisible). Force them to
         the on-colour ink so they read on the coloured header. -->
    <Style Selector="dock|ToolChromeControl:active /template/ Path">
        <Setter Property="Fill" Value="{DynamicResource ThemeOnColorTextBrush}"/>
    </Style>
    <Style Selector="dock|ToolChromeControl:active /template/ TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnColorTextBrush}"/>
    </Style>

    <!-- Dock tabs: rounded tops, padding, a hover wash, and an accent-filled selected tab. Tool and
         document tabs share the look. -->
    <Style Selector="dock|ToolTabStripItem, dock|DocumentTabStripItem">
        <Setter Property="CornerRadius" Value="10,10,0,0"/>
        <Setter Property="Padding" Value="12,5"/>
        <!-- Left margin (2) spaces tabs apart; top is 0 so the tab sits FLUSH against the content outline
             above it (a top margin left a tab-strip gap between the focus ring's bottom and the tab). -->
        <Setter Property="Margin" Value="2,0,0,0"/>
    </Style>
    <Style Selector="dock|ToolTabStripItem:pointerover, dock|DocumentTabStripItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource DockTabHoverBackgroundBrush}"/>
    </Style>
    <!-- The SELECTED tab is always an accent pill with on-colour text. Verified against Dock 12.0.0.2's
         DocumentTabStripItem.axaml: PART_TabBody binds {TemplateBinding Background} and the :selected
         states set the ITEM's Background, so setting the item Background directly overrides Dock's
         :not(:active):selected / :active:selected states in both window-focused and unfocused cases. -->
    <Style Selector="dock|DocumentTabStripItem:selected, dock|ToolTabStripItem:selected">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentSolidBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnColorTextBrush}"/>
        <!-- Pin geometry to the UNSELECTED values so focusing a tab never changes its size or position:
             Dock's stock :selected styles otherwise add a border, swap padding, and zero the margin. -->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
    </Style>
    <Style Selector="dock|DocumentTabStripItem:selected:pointerover, dock|ToolTabStripItem:selected:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnColorTextBrush}"/>
    </Style>

    <!-- Pinned tool tabs (the collapsed auto-hide strip) mirror the docked tabs above: the same muted
         tab-text colour, the same hover wash, and the same accent pill when focused. Dock's
         ToolPinItemControl is a transparent Border (binds the control Background) wrapping a Button +
         title TextBlock, so the wash / accent go on the control Background; the inner Button swaps to
         the flat theme above so Fluent's own hover tint doesn't fight it. -->
    <Style Selector="dock|ToolPinItemControl /template/ TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DockTabForegroundBrush}"/>
    </Style>
    <Style Selector="dock|ToolPinItemControl /template/ Button">
        <Setter Property="Theme" Value="{StaticResource PinTabButtonTheme}"/>
    </Style>
    <Style Selector="dock|ToolPinItemControl:pointerover">
        <Setter Property="Background" Value="{DynamicResource DockTabHoverBackgroundBrush}"/>
    </Style>
    <Style Selector="dock|ToolPinItemControl:focus-within">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentSolidBrush}"/>
    </Style>
    <Style Selector="dock|ToolPinItemControl:focus-within /template/ TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnColorTextBrush}"/>
    </Style>
</Styles>
